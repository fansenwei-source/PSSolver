  "scale_safe_magnitude_schema": {
    "name": "channel_pressure_active_rms_magnitude.v1",
    "json_safe": true,
    "fields": [
      "is_zero",
      "float64_value",
      "representable_as_positive_float64",
      "log2_value",
      "binary_mantissa",
      "binary_exponent"
    ],
    "active_value_definition": "complex coefficient on the projected pressure subspace after null and even-periodic Nyquist masks",
    "active_pressure_degree_definition": "number of active complex pressure coefficients; a complex coefficient counts once",
    "component_amax_definition": "maximum of abs(real) and abs(imag) over active coefficients",
    "rms_definition": "component_amax * sqrt(sum(abs(active/component_amax)^2) / active_pressure_degrees_of_freedom)",
    "nonzero_encoding": {
      "is_zero": false,
      "float64_value": "finite positive float when representable, otherwise null",
      "representable_as_positive_float64": "true exactly when float64_value is finite and positive",
      "log2_value": "finite float",
      "binary_mantissa": "finite float in [0.5, 1.0)",
      "binary_exponent": "integer such that magnitude = binary_mantissa * 2**binary_exponent"
    },
    "zero_encoding": {
      "is_zero": true,
      "float64_value": 0.0,
      "representable_as_positive_float64": false,
      "log2_value": null,
      "binary_mantissa": null,
      "binary_exponent": null
    },
    "zero_is_determined_by": "exact_active_coefficient_zero_test_not_float64_value",
    "subnormal_nonzero_must_not_be_mislabeled_zero": true,
    "NaN_or_infinity_allowed": false
  },
  "numerical_scale_contract": {
    "public_absolute_scale": "channel_pressure_active_rms_magnitude.v1",
    "normalized_residual": "active_rms(projected_residual) / active_rms(projected_rhs)",
    "normalized_residual_denominator": "projected_rhs_not_initial_warm_start_residual",
    "working_vector_scale": "largest exactly representable power of two not greater than component_amax",
    "working_scale_binary_exponent_required_in_diagnostics": true,
    "working_quadratic_products_use_normalized_space": true,
    "operator_breakdown": "abs(mean_active(conj(direction) * operator_direction)) <= eps * active_rms(direction) * active_rms(operator_direction)",
    "preconditioned_residual_breakdown": "abs(mean_active(conj(residual) * preconditioned)) <= eps * active_rms(residual) * active_rms(preconditioned)",
    "zero_vector_scale_is_breakdown_unless_exact_zero_residual_already_established": true,
    "absolute_breakdown_threshold_allowed": false,
    "normwise_backward_error": "small_grid_independent_qualification_diagnostic_only",
    "inactive_pressure_modes_contribute": false,
    "same_definition_required_for": [
      "production_primal",
      "functional_primal",
      "functional_transpose",
      "standalone_transpose_qualification",
      "small_grid_unrolled_oracle"
