  "requirements": [
    {
      "id": "R1",
      "name": "functional_runtime_protocol",
      "first_periodic_slice_blocking": true,
      "first_owner": "P9.1",
      "acceptance": "explicit construction, immutable specs, capabilities, identity, api version, no production mutation, unsupported combinations fail without fallback"
    },
    {
      "id": "R2",
      "name": "immutable_complete_functional_state",
      "first_periodic_slice_blocking": true,
      "first_owner": "P9.1",
      "acceptance": "flat tensor tuple and layout include every evolved, integrator-history, and persistent algebraic value that affects the next step"
    },
    {
      "id": "R3",
      "name": "pure_step_and_combined_observation",
      "first_periodic_slice_blocking": true,
      "first_owner": "P9.2",
      "acceptance": "actual integrator map, no input mutation or conversion, and input-state step_and_observe output bitwise equal to separate observe"
    },
    {
      "id": "R4",
      "name": "declared_runtime_identity",
      "first_periodic_slice_blocking": true,
      "first_owner": "P9.1",
      "acceptance": "JSON scientific, discretization, and execution identity includes executor, dtype, device, state layout, and deterministic settings"
    },
    {
      "id": "R5",
      "name": "deterministic_replay",
      "first_periodic_slice_blocking": true,
      "first_owner": "P9.3",
      "acceptance": "same state and control replay bitwise on one device, dtype, and execution identity; hidden warm state is forbidden"
    },
    {
      "id": "R6",
      "name": "named_differentiable_observations",
      "first_periodic_slice_blocking": true,
      "first_owner": "P9.2",
      "acceptance": "input-state observations declare field meaning and convention; terminal observation omits control-dependent algebraic fields"
    },
    {
      "id": "R7",
      "name": "control_field_injection_schema",
      "first_periodic_slice_blocking": true,
      "first_owner": "P9.2",
      "acceptance": "name, shape, dtype, device, placement, broadcast, equation term, and dealiasing are explicit; no parameter-registry mutation"
    },
    {
      "id": "R8",
      "name": "model_owned_physical_admissibility",
      "first_periodic_slice_blocking": false,
      "first_owner": "P9.2",
      "acceptance": "model declares physical bounds and a consumer parameterization outside them fails at construction without clipping"
    },
    {
      "id": "R9",
      "name": "durable_checkpoint_state_bridge",
      "first_periodic_slice_blocking": false,
      "first_owner": "P9.3",
      "acceptance": "versioned export and import validate identity, layout, shape, dtype, checksum, and finiteness before copying data"
    },
    {
      "id": "R10",
      "name": "differentiability_capabilities",
      "first_periodic_slice_blocking": true,
      "first_owner": "P9.2",
      "acceptance": "runtime declares differentiable state/control inputs, reverse-mode support, and inner-solve differentiation semantics"
    },
    {
      "id": "R11",
      "name": "explicit_jvp_vjp_and_custom_adjoint",
      "first_periodic_slice_blocking": false,
      "first_owner": "P9.7",
      "acceptance": "custom adjoints pass transpose tests and agree with an unrolled small-grid reference"
    },
    {
      "id": "R12",
      "name": "production_functional_consistency",
      "first_periodic_slice_blocking": true,
      "first_owner": "P9.4",
      "acceptance": "per-step state and observation comparison uses frozen strict tolerances and fails closed without an approximate override"
    }
  ],
