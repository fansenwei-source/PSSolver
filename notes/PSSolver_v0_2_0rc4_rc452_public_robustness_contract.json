  "issues": {
    "B7": {
      "cohort": "checkpoint_transactionality",
      "decision": "current schemas reject every unregistered key at every level; legacy inputs require an explicit registered reader",
      "implementation_stage": "RC4.5.3"
    },
    "B9": {
      "cohort": "boundary_semantics",
      "decision": "finite-Q anchoring treats parallel and antiparallel unit directors as the same physical declaration and canonicalizes both to the oriented face normal",
      "implementation_stage": "RC4.5.4"
    },
    "B11": {
      "cohort": "accelerator_global_state",
      "decision": "TF32 policy is dynamically scoped and restores every caller-owned torch flag after success or failure",
      "implementation_stage": "RC4.5.6"
    },
    "B13": {
      "cohort": "public_validation_and_observability",
      "decision": "all public application compilers share one device and pressure-option validation contract before output creation",
      "implementation_stage": "RC4.5.5"
    },
    "B15": {
      "cohort": "public_validation_and_observability",
      "decision": "all four application families add one diagnostics-envelope schema while retaining existing payload bytes and filenames",
      "implementation_stage": "RC4.5.5"
    },
    "B17": {
      "cohort": "public_validation_and_observability",
      "decision": "capability catalogue, normalization, compiler and public exception translation describe one truth table",
      "implementation_stage": "RC4.5.5"
    },
    "B21": {
      "cohort": "boundary_semantics",
      "decision": "the public dimensionless Robin impedance interval is closed and finite: 0 <= lower, upper <= 1e14",
      "implementation_stage": "RC4.5.4"
    },
    "B24": {
      "cohort": "checkpoint_transactionality",
      "decision": "all checkpoint surfaces expose the same semantic error categories and never leak an unclassified filesystem-shape error",
      "implementation_stage": "RC4.5.3"
    },
    "B27": {
      "cohort": "checkpoint_transactionality",
      "decision": "every writer stages on the target filesystem, publishes atomically, respects caller umask and removes all failed staging state",
      "implementation_stage": "RC4.5.3"
    }
  },
  "checkpoint_contract": {
